        "title": "DspModSlot",
        "boxes": [
            {
                "box": {
                    "maxclass": "comment",
                    "text": "One mod slot, as the MSP `ModRouter`. The source is scaled by the amount and goes out the destination's signal outlet. On each note, the source's value (velocity, key, random, or the signal's current value) times the amount also goes out the destination's message outlet, for the destinations read once per note. Velocity, key and random hold their value until the next note.",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "id": "obj-1",
                    "patching_rect": [ 1070.0, 20.0, 420.0, 140.0 ],
                    "linecount": 7
                }
            },
